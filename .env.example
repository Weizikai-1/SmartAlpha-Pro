# SmartAlpha Pro 环境变量配置
# 
# 使用方法:
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 将 your_xxx_here 替换为真实 token/key
#
# Tushare Token:  https://tushare.pro -> 个人主页 -> 接口TOKEN
# DeepSeek Key:   https://platform.deepseek.com -> API Keys

ENV=development
TUSHARE_TOKEN=your_token_here
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DATA_SOURCE=tushare

# 可选: Redis (缓存加速, 不配则使用本地Parquet缓存)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 可选: 回测参数 (都有默认值, 不配也能跑)
BACKTEST_START_DATE=20200101
BACKTEST_END_DATE=20261231
INITIAL_CAPITAL=1000000
COMMISSION_RATE=0.0003
SLIPPAGE_RATE=0.001
STAMP_DUTY_RATE=0.001
MAX_POSITION_PCT=0.1
MAX_INDUSTRY_PCT=0.3
STOP_LOSS_PCT=0.1
STOP_PROFIT_PCT=0.3
VAR_CONFIDENCE=0.95
