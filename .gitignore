# ══════════════════════════════════════════════════════════
# SmartAlpha Pro — Git 忽略规则
# ══════════════════════════════════════════════════════════

# ── 密钥 & 环境变量 (绝对不能提交) ──
.env

# ── Python 编译产物 ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── 测试缓存 & 覆盖率 ──
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# ── IDE & 系统 ──
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
*.bak

# ── 大型数据文件 (用户自行下载) ──
# raw: 原始API下载数据
data/raw/
# processed: 预处理后的大文件 (factors_neutral.parquet ~5.7MB)
data/processed/
# 生成的面板数据
data/panel_all.parquet

# ── 模型二进制 (太大, 且环境相关) ──
*.joblib
*.pkl
*.pt
*.pth
smartalpha/model/saved/

# ── ChromaDB 向量库 ──
chroma_db/
*.chroma/

# ── 生成产物 (非源码) ──
llm_analysis_report.md
llm_analysis_result.json
backtest_metrics.json

# ── 临时脚本 & 输出 ──
run_backtest.py
run_llm_analysis.py
run_tests.py
test_output.txt
test_a_result.txt
test_results.txt
demo_script.md
git_push.py

# ── 日志 ──
*.log
logs/

# ── Jupyter ──
.ipynb_checkpoints/
*.ipynb

# ── Docker ──
docker-compose.override.yml
